# ==============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - LAVI (IG-OSINT MANAGER)
# ==============================================================================
# Renomeie este arquivo para .env e preencha com dados seguros de produção.
# NUNCA envie o arquivo .env preenchido para repositórios Git!

# 1. Configurações de Domínio e Rede
# Defina o domínio público que apontará para a VPS (usado pelo Caddy para obter SSL Let's Encrypt automático)
# Se for usar apenas o IP na fase inicial de testes, use o IP (ex: 123.45.67.89), mas lembre-se
# que o Caddy não emite SSL para IPs brutos, operando de forma HTTP efêmera nesse caso.
DOMAIN_NAME=lavi.seu-dominio.com

# 2. Credenciais Administrativas Iniciais
# Estas credenciais serão usadas para criar o primeiro usuário admin caso o banco esteja vazio.
# Você deve alterá-las no primeiro login através do painel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=substitua_por_uma_senha_muito_segura_2026

# 3. Segurança de Sessão JWT
# Chave de criptografia simétrica para assinatura de tokens JWT.
# Gere uma chave forte de 32 bytes (ex: rodando `openssl rand -hex 32` no terminal)
SECRET_KEY=substitua_por_uma_chave_hexadecimal_aleatoria_de_32_bytes

# 4. Diretórios e Persistência Internos (Não altere a menos que mude o Dockerfile)
DATABASE_PATH=/app/data/storage.db
DOWNLOAD_DIR=/app/data/downloads
SESSION_DIR=/app/data/sessions
